# Database connection string
# Prisma CLI resolves relative paths relative to prisma directory (e.g. file:../dev.db)
# Next.js runtime resolves relative paths relative to process.cwd() (resolved by lib/prisma.ts)
DATABASE_URL="file:../dev.db?connection_limit=1"

# JWT Secret Keys (Run 'openssl rand -base64 32' to generate secure keys)
# MUST be set in production for security
JWT_SECRET="generate_a_secure_random_key_for_production"
JWT_REFRESH_SECRET="generate_a_secure_random_refresh_key_for_production"

# Environment Settings
NODE_ENV="production"
PORT=3000
