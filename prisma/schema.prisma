datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String
  isActive       Boolean  @default(true)
  resetRequested Boolean  @default(false)
  resetPinHash   String?
  resetPinExpiry DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Patient {
  patientId        String   @id @default(uuid())
  opNumber         String   @unique
  fullName         String
  age              String
  gender           String
  phone            String
  bloodGroup       String
  department       String
  doctor           String
  complaint        String   @default("")
  address          String
  status           String   @default("Active")
  appointmentDate  String   @default("")
  appointmentTime  String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  consultations    Consultation[]
}

model Consultation {
  id               String   @id @default(uuid())
  patientId        String
  opNumber         String
  doctor           String
  department       String
  diagnosis        String   @default("")
  notes            String   @default("")
  prescription     String   @default("[]") // JSON string of medicines
  followUpDate     String   @default("")
  consultationDate DateTime @default(now())
  status           String   @default("Waiting")
  patient          Patient  @relation(fields: [patientId], references: [patientId], onDelete: Cascade)
}

model InvestigationMaster {
  code        String @id
  name        String
  description String @default("")
  category    String
  type        String @default("Investigation")
  price       Float
}

model InvestigationTransaction {
  id          String   @id @default(uuid())
  patientId   String
  opNumber    String
  testName    String
  amount      Float
  doctor      String
  status      String   @default("Pending")
  result      String   @default("")
  orderedDate DateTime @default(now())
}

model InventoryItem {
  medicineId   String   @id @default(uuid())
  medicineName String   @unique
  category     String
  batch        String   @default("")
  stock        Int      @default(0)
  price        Float    @default(0)
  mrp          Float    @default(0)
  expiryDate   String   @default("")
  distributor  String   @default("")
  createdAt    DateTime @default(now())
}

model PharmacyDispense {
  id            String   @id @default(uuid())
  patientId     String
  opNumber      String
  billId        String   @default("")
  medicineName  String
  batch         String   @default("")
  quantity      Int
  price         Float
  amount        Float
  dispensedBy   String
  dispensedDate DateTime @default(now())
}

model Bill {
  billNumber          String   @id
  patientId           String
  opNumber            String
  items               String   // JSON string of bill items
  consultationCharges Float    @default(0)
  investigationCharges Float    @default(0)
  medicineCharges     Float    @default(0)
  otCharges           Float    @default(0)
  total               Float
  paidAmount          Float
  pendingAmount       Float
  paymentMode         String
  status              String   @default("Unpaid")
  date                DateTime @default(now())
}

model OTProcedure {
  id            String   @id @default(uuid())
  patientId     String
  opNumber      String
  doctor        String
  procedureName String
  cost          Float
  status        String   @default("Scheduled")
  date          String
  notes         String   @default("")
  createdAt     DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  timestamp  DateTime @default(now())
  user       String
  role       String
  module     String
  action     String
  recordId   String
  ipAddress  String   @default("Unknown")
  status     String   @default("Success")
  patientId  String?
  remarks    String?
  details    String?
}

model ClinicalTemplate {
  id              String   @id @default(uuid())
  chiefComplaint  String   @unique
  templateText    String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DotPhrase {
  id        String   @id @default(uuid())
  shortcut  String   @unique
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SmartChip {
  id             String   @id @default(uuid())
  chiefComplaint String   @unique
  examChips      String   // JSON string array
  diagnosisChips String   // JSON string array
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SystemSettings {
  id                 String   @id @default("default")
  emailAlertsEnabled Boolean  @default(false)
  targetEmail        String   @default("")
  updatedAt          DateTime @updatedAt
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  fee       Float    @default(500)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
